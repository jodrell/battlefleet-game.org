#!/bin/bash
set -euo pipefail
IFS=$'\n\t'

DIR="$1"

echo "starting at $(date)..."

pushd "$(dirname "$0")" > /dev/null

echo "working in '${PWD}'..."

echo "resetting working directory to a known-good state..."

git reset --hard origin/main

echo "updating from origin..."

git fetch origin main

git merge origin/main

echo "building site in ${DIR}..."

mkdocs build --site-dir "$DIR"

cp -fv docs/.htaccess "${DIR}/"

popd > /dev/null

echo "finished at $(date)"
